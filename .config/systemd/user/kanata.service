[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Environment=PATH=/home/barrettjflowers/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Type=simple
ExecStart=/home/barrettjflowers/.cargo/bin/kanata --cfg /home/barrettjflowers/.config/kanata/config.kbd --no-wait --port 10000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
