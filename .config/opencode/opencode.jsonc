{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "ollama/qwen3:1.7b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen 3 8B",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3:1.7b": {
          "name": "Qwen 3 1.7B",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}