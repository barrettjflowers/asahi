shell /usr/bin/zsh
term xterm-256color

#allow_remote_control yes

font_family MesloLGS Nerd Font Mono
font_size 12
disable_ligatures never
enable_audio_bell no

# Layout
window_padding_width 12
#remember_window_position no
#remember_window_size no
#initial_window_width 500
#initial_window_height 280

confirm_os_window_close 30
background_opacity 0.75

cursor_shape block
cursor_shape_unfocused block
cursor_blink_interval 0.5
cursor_trail 0

# maps
#map ctrl+a launch --type=overlay zsh -c "~/.scripts/windows.sh; exec zsh"
#map ctrl+v launch --type=overlay zsh -c "~/.scripts/clipboard.sh; exec zsh"
#map ctrl+d launch --type=overlay zsh -c "~/.scripts/dict.sh; exec zsh"
#map ctrl+s launch --type=overlay zsh -c "~/.scripts/raycast.sh; exec zsh"

# BEGIN_KITTY_THEME
# Chalk
include current-theme.conf
# END_KITTY_THEME
