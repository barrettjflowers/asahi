@import "../colors/colors.rasi"

configuration {
    font:                        "JetBrainsMono Nerd Font Mono Medium 11";
    location:                    1;
    drun-display-format:         "{name}";
}

* {
    background:                  transparent;
    background-color:            transparent;
    background-color-alt:        transparent;
    foreground:                  @foreground-color;
    selected-background:         transparent;
    separatorcolor:              transparent;
    lightbg:                     transparent;
    normal-background:           transparent;
    normal-foreground:           @foreground-color;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @foreground-color;
    selected-normal-foreground:  @off;
    selected-normal-background:  @border-color;
    urgent-foreground:           @urgent;
    active-foreground:           @foreground-color;
}

window {
    x-offset:                  13;
    y-offset:                  6;
    padding:                   0;
    transparency:              "real";
    background-color:          @bg;
    text-color:                @foreground-color;
    border:                    0px;
    border-color:              @off;
    border-radius:             0;
    width:                     600px;
}

mainbox {
    spacing:                   0;
    padding:                   0;
    background-color:          transparent;
    border:                    2px;
		border-radius:             10px;
    border-color:                @border-color;
}

inputbar {
    padding:                   12px;
    spacing:                   8px;
    children:                  [entry, prompt, indicator, case-indicator];
    background-color:          transparent;
}

prompt {
    text-color:                @foreground-color-alt;
    background-color:          transparent;
}

entry {
    text-color:                @foreground-color;
    placeholder:               "Search...";
    placeholder-color:         @foreground-color-alt;
    cursor-color:              @accent-color;
    blink:                     true;
    background-color:          transparent;
}

listview {
    spacing:                   0;
    padding:                   0;
    lines:                     10;
    columns:                   1;
    fixed-height:              true;
    dynamic:                   true;
    background-color:          transparent;
}

element {
    padding:                   8px 12px;
    text-color:                @foreground-color;
    background-color:          transparent;
}

element normal {
    background-color:          transparent;
}

element normal active {
    text-color:                @foreground-color;
    background-color:          transparent;
}

element urgent {
    text-color:                @urgent;
    background-color:          transparent;
}

element selected {
    text-color:                @off;
    background-color:          @border-color;
}

element selected.urgent {
    text-color:                @urgent;
    background-color:          @border-color;
}

element selected.active {
    text-color:                @accent-color;
    background-color:          @border-color;
}

element-icon {
    size:                      24px;
    background-color:          transparent;
}

element-text {
    text-color:                inherit;
    vertical-align:            0.5;
    horizontal-align:          0.0;
    background-color:          transparent;
}

button {
    text-color:                @foreground-color;
    background-color:          transparent;
}

scrollbar {
    handle-color:              @accent-color;
    handle-width:              4px;
}

sidebar {
    border:                    0px;
    border-color:              @border-color;
    background-color:          transparent;
}

button.selected {
    text-color:                @off;
    background-color:          @border-color;
}

error-message {
    background-color:          transparent;
    text-color:                @foreground-color;
    border:                    0px;
    border-color:              @border-color;
}

textbox {
    text-color:                @foreground-color;
    background-color:          transparent;
}
