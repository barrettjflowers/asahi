[
    // left half: ends at the notch (width 1600 logical / 2 = 800)
    {
        "name": "left",
        "layer": "top",
        "height": 26,
        "fixed-center": false, // no reserved middle section, so each side can use the full half
        "position": "top",
        "reload_style_on_change": true,
        "spacing": 0, // gaps come from CSS margins, so the empty window module takes no slot
        "margin-top": 4,
        "margin-bottom": -2,
        "margin-left": 3,
        "margin-right": 640,
        "modules-right": ["custom/power", "custom/backlight", "pulseaudio", "hyprland/workspaces", "hyprland/window", "custom/disk", "custom/recording"],

        "hyprland/window": {
            "format": "{class}",
            // jsoncpp sorts keys and every matching rule applies in turn: cap at 7 (key "("), then prefix (key "^")
            "rewrite": {
                "(.{7}).+": "$1… ",
                "^(.+)$": "› $1", // empty class stays empty, so waybar hides the module
            },
        },

        "hyprland/workspaces": {
            "format": "{id}",
            "persistent-workspaces": {
                "*": [ 1,2,3,4,5 ]
            }
        },
        "custom/power": {
            "format": "󰐥 Power",
            "tooltip-format": "systemctl poweroff",
            "on-click": "systemctl poweroff"
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "󰖁 {volume}%",
            "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
            "tooltip-format": "{desc}",
            "on-click": "~/.config/waybar/scripts/audio-toggle.sh"
        },
        "custom/backlight": {
            "exec": "~/.config/waybar/scripts/kbd-backlight.sh",
            "return-type": "json",
            "interval": 5, // catches manual brightness changes
            "signal": 9,
            "on-click": "~/.config/waybar/scripts/kbd-backlight.sh toggle"
        },
        "custom/notification": {
            "tooltip": false,
            "format": "",
            "on-click": "swaync-client -t -sw",
            "escape": true
        },
        "custom/disk": {
            "exec": "~/.config/waybar/scripts/disk.sh",
            "return-type": "json",
            "format": "󰣳 {}",
            "interval": 60
        },
        "custom/recording": {
            "format": "{}",
            "return-type": "json",
            "interval": 1,
            "exec": "~/.config/waybar/scripts/record-indicator.sh",
            "tooltip": false
        },
        "bluetooth": {
            "format-on": "󰂯",
            "format-off": "BT-off",
            "format-disabled": "󰂲",
            "format-connected-battery": "{device_battery_percentage}% 󰂯",
            "format-alt": "{device_alias} 󰂯",
            "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
            "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
            "on-click-right": "blueman-manager",
        },
        "custom/pacman": {
            "format": "󰅢 {}",
            "interval": 30,   
            "exec": "checkupdates | wc -l",
            "exec-if": "exit 0",
            "on-click": "kitty sh -c 'yay -Syu; echo Done - Press enter to exit; read'; pkill -SIGRTMIN+8 waybar",
            "signal": 8,
            "tooltip": false,
        },
        "tray": {
            "icon-size": 14,
            "spacing": 10
        },
    },
    // right half: starts at the notch
    {
        "name": "right",
        "exclusive": false, // the left bar reserves the space; two reservations would stack
        "layer": "top",
        "height": 26,
        "fixed-center": false, // no reserved middle section, so each side can use the full half
        "position": "top",
        "reload_style_on_change": true,
        "spacing": 7,
        "margin-top": -24, // 4 minus the left bar's 28px reserved strip
        "margin-bottom": -2,
        "margin-left": 640,
        "margin-right": 3,
        "modules-left": ["group/metrics", "battery", "network", "clock"],

        // one shared background; a group's children have no bar spacing between them
        "group/metrics": {
            "orientation": "horizontal",
            "modules": ["cpu", "custom/memory", "custom/weather"]
        },

        "clock": {
            "format": "󱑃 {:%a %d %b %I:%M}",
            "interval": 1,   
            "tooltip-format": "<tt>{calendar}</tt>",
            "on-click": "d=$(date +%F); printf %s \"$d\" | wl-copy && notify-send -a Clock 'Date copied' \"$d\"",
            "calendar": {
                "format": {
                    "today": "<span background='#bfb8a7'>{}</span>"
                }
            }
        },
        "network": {
            "format-wifi": "󰖩 {essid}",
            "max-length": 18, // icon + space + 15 SSID chars + "…"
            "format-ethernet":"",
            "format-disconnected": "",
            "tooltip-format-disconnected": "Error",
            "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
            "tooltip-format-ethernet": "{ifname} 🖧 ",
            "on-click": "kitty nmtui"
        },
        "battery": {
            "interval":30,
            "states": {
                "good": 95,
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-plugged": "  {capacity}%",
            "format-warning": "{icon} {capacity}%",
            "format-critical": "{icon} {capacity}%",
            "format-alt": "{icon} {time}",
            "format-icons": [
                "",
                "",
                "",
                "",
                "",
                ""
            ],
        },
        "cpu": {
            "format": " {usage}%",
            "interval": 2,
            "tooltip": true,
            "on-click": ""
        },
        "custom/memory": {
            "exec": "~/.config/waybar/scripts/memory.sh",
            "tooltip": false,
            "format": " {}GB",
            "interval": 5,
            "on-click": ""
        },
        "custom/weather": {
            "exec": "~/.config/waybar/scripts/weather.sh",
            "restart-interval": 5,
            "format": " {}",
            "tooltip": true,
            "on-click": ""
        },
    }
]
