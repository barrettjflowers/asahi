{
        "layer": "top",
        "position": "top",
        "reload_style_on_change": true,
        "spacing": 7,
        "margin-top": 6,
        "margin-bottom": -4,
        "margin-left": 3,
        "margin-right": 3,
        "modules-left": ["custom/power", "hyprland/workspaces", "hyprland/window"],
        "hyprland/window": {
            "format": "›  {class}",
        },
        "modules-center": ["disk","custom/recording","cpu","custom/memory","custom/weather"],
        "modules-right": ["battery","network","clock"],


        "hyprland/workspaces": {
            "format": "{id}",
            "persistent-workspaces": {
                "*": [ 1,2,3,4,5 ]
            }
        },
        "custom/power": {
            "format": "󰐥 Power",
            "tooltip-format": "systemctl poweroff",
            "on-click": "systemctl poweroff"
        },
        "custom/notification": {
            "tooltip": false,
            "format": "",
            "on-click": "swaync-client -t -sw",
            "escape": true
        },
        "clock": {
            "format": "󱑃 {:%a %d %b %I:%M}",
            "interval": 1,   
            "tooltip-format": "<tt>{calendar}</tt>",
            "on-click": "d=$(date +%F); printf %s \"$d\" | wl-copy && notify-send -a Clock 'Date copied' \"$d\"",
            "calendar": {
                "format": {
                    "today": "<span background='#3f423f'>{}</span>"
                }
            }
        },
        "network": {
            "format-wifi": "󰖩 {essid}",
            "format-ethernet":"",
            "format-disconnected": "",
            "tooltip-format-disconnected": "Error",
            "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
            "tooltip-format-ethernet": "{ifname} 🖧 ",
            "on-click": "kitty nmtui"
        },
        "bluetooth": {
            "format-on": "󰂯",
            "format-off": "BT-off",
            "format-disabled": "󰂲",
            "format-connected-battery": "{device_battery_percentage}% 󰂯",
            "format-alt": "{device_alias} 󰂯",
            "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
            "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
            "on-click-right": "blueman-manager",
        },
        "battery": {
            "interval":30,
            "states": {
                "good": 95,
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-plugged": "  {capacity}%",
            "format-warning": "{icon} {capacity}%",
            "format-critical": "{icon} {capacity}%",
            "format-alt": "{icon} {time}",
            "format-icons": [
                "",
                "",
                "",
                "",
                "",
                ""
            ],
        },
        "custom/pacman": {
            "format": "󰅢 {}",
            "interval": 30,   
            "exec": "checkupdates | wc -l",
            "exec-if": "exit 0",
            "on-click": "kitty sh -c 'yay -Syu; echo Done - Press enter to exit; read'; pkill -SIGRTMIN+8 waybar",
            "signal": 8,
            "tooltip": false,
        },
        "custom/recording": {
            "format": "{}",
            "return-type": "json",
            "interval": 1,
            "exec": "~/.config/waybar/scripts/record-indicator.sh",
            "tooltip": false
        },

        "cpu": {
            "format": " {usage}%",
            "interval": 2,
            "tooltip": true,
            "on-click": ""
        },
        "custom/memory": {
            "exec": "~/.config/waybar/scripts/memory.sh",
            "tooltip": false,
            "format": " {}GB",
            "interval": 5,
            "on-click": ""
        },
        "custom/weather": {
            "exec": "~/.config/waybar/scripts/weather.sh",
            "restart-interval": 5,
            "format": " {}",
            "tooltip": true,
            "on-click": ""
        },
        "tray": {
            "icon-size": 14,
            "spacing": 10
        },
        "disk": {
            "format": "󰣳 {specific_used:0.1f}/{specific_total:0.1f}GB",
            "unit": "GB",
            "interval": 60
        },
} 

