(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 200
  sequence-timeout 300
  log-layer-changes yes
  danger-enable-cmd yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet   rctl
)

(defalias
  vim-toggle (layer-switch vim-normal)
  sym-toggle (layer-switch symbol)
)

(defchordsv2
  (j k) @vim-toggle 90 first-release (vim-normal)
  (z m) @sym-toggle 90 first-release (symbol)
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet   rctl
)

(defvirtualkeys
  del-word (macro S-C-rght del)
  del-back (macro S-C-left del)
  del-line (macro home S-end del)
)

(defseq
  del-word (d w)
  del-back (d b)
  del-line (d d)
)

(deflayermap (vim-normal)
  h    left
  j    down
  k    up
  l    rght
  w    C-rght
  b    C-left
  e    C-rght
  d    sldr
  x    del
  i    (layer-switch base)
  u    C-z
  esc  (layer-switch base)
  caps (layer-switch base)
)

(deflayermap (symbol)
  grv   (layer-switch base)
  esc   (layer-switch base)
  caps  (layer-switch base)
  ,     (macro (cmd wl-copy "←") 50 C-v)
  .     (macro (cmd wl-copy "→") 50 C-v)
  0     (macro (cmd wl-copy "°") 50 C-v)
  =     (macro (cmd wl-copy "≠") 50 C-v)
  -     (macro (cmd wl-copy "—") 50 C-v)
)
