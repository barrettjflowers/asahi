# Ignore everything
*

# Except...
!*.vimrc
!*.vim
!*.zshrc
!*.bashrc
!.gitignore
!.gitignore_global
!.bashrc
!.fzf
!/.scripts/
!/.scripts/*
!.tmux.conf
!.gtkrc-2.0

# Curated .config allow-list. Everything else remains ignored by `*` above
!/.config/

# System snapshots and desktop configuration
!/.config/asahi/
!/.config/asahi/**
!/.config/autostart/
!/.config/autostart/**
!/.config/btop/
!/.config/btop/**
!/.config/colors/
!/.config/colors/**
!/.config/css/
!/.config/css/**
!/.config/fastfetch/
!/.config/fastfetch/**
!/.config/fontconfig/
!/.config/fontconfig/**
!/.config/hypr/
!/.config/hypr/**
!/.config/kanata/
!/.config/kanata/**
!/.config/kitty/
!/.config/kitty/**
!/.config/nvim/
!/.config/nvim/**
!/.config/qt5ct/
!/.config/qt5ct/**
!/.config/qt6ct/
!/.config/qt6ct/**
!/.config/rofi/
!/.config/rofi/**
!/.config/swaync/
!/.config/swaync/**
!/.config/systemd/
!/.config/systemd/**
!/.config/waybar/
!/.config/waybar/**
!/.config/xsettingsd/
!/.config/xsettingsd/**
!/.config/yazi/
!/.config/yazi/**

# GTK configuration, excluding machine-specific bookmarks
!/.config/gtk-3.0/
!/.config/gtk-3.0/assets/
!/.config/gtk-3.0/assets/**
!/.config/gtk-3.0/colors.css
!/.config/gtk-3.0/gtk.css
!/.config/gtk-3.0/settings.ini
!/.config/gtk-3.0/window_decorations.css
!/.config/gtk-4.0/
!/.config/gtk-4.0/colors.css
!/.config/gtk-4.0/gtk.css
!/.config/gtk-4.0/settings.ini
!/.config/gtk-4.0/window_decorations.css

!/.config/sunshine/
!/.config/sunshine/apps.json
!/.config/sunshine/sunshine.conf

# Standalone application and desktop settings
!/.config/.gtkrc-2.0
!/.config/QtProject.conf
!/.config/gtkrc
!/.config/gtkrc-2.0
!/.config/kdeglobals
!/.config/kdenliverc
!/.config/powermanagementprofilesrc

# Unignore .github directory and its contents
!/.github
!/.github/**

# Claude Code global instructions only (no credentials, history, or projects)
!/.claude/
!/.claude/CLAUDE.md

# VNC units stay local and untracked
/.config/systemd/user/wayvnc*.service
/.config/systemd/user/novnc.service
/.config/systemd/user/*.wants/wayvnc*.service
/.config/systemd/user/*.wants/novnc.service

# Editor swap files and macOS AppleDouble files
.*.sw[a-p]
.sw[a-p]
._*
